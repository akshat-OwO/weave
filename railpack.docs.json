{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "buildAptPackages": ["ca-certificates", "curl"],
  "packages": {
    "bun": "1.3.14",
    "node": "24"
  },
  "caches": {
    "nub-install": {
      "directory": "/root/.cache/nub",
      "type": "shared"
    }
  },
  "steps": {
    "install": {
      "commands": [
        "curl -fsSL https://nubjs.com/install.sh | NUB_INSTALL_DIR=/opt/nub NUB_NO_MODIFY_PATH=1 bash -s -- 0.5.0",
        "/opt/nub/bin/nub install --frozen-lockfile"
      ],
      "caches": ["nub-install"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["bunx turbo build --filter=@weave/docs"]
    }
  },
  "deploy": {
    "startCommand": "bun run --cwd apps/docs start",
    "variables": {
      "HOSTNAME": "0.0.0.0",
      "NEXT_TELEMETRY_DISABLED": "1",
      "NODE_ENV": "production",
      "PORT": "3000"
    }
  }
}
